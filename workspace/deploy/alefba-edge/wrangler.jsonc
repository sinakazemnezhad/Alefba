{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alefba",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  // Standalone Alefbâ — NOT Noetfield / NOT SourceB / NOT PLR hosting.
  "account_id": "0d0b967b77e2e5535455d39ff3dae72c",
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS"
  },
  "vars": {
    "ALEFBA_VERSION": "0.2.8",
    "INSTRUCT_MVP": "not_live",
    "MIGRATION_PHASE": "g3_waitlist_d1",
    "RAILWAY_ORIGIN": "https://alefba-production.up.railway.app",
    "ALEFBA_PUBLIC_ORIGIN": "https://alefba.sina-kazemnezhad-ca.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alefba-g3",
      "database_id": "35ac9849-4fb3-42df-ac65-c1ddb90cb532"
    }
  ]
}
